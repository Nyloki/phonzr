        ["chroma"] = 0,
        ["ancient"] = 0,
        ["godly"] = 0,
        ["legendary"] = 0,
        ["unique"] = 0,
        ["rare"] = 0,
        ["uncommon"] = 0,
        ["common"] = 0,
        ["vintage"] = 0,
        ["unknown"] = 0
    }
    
    for _, item in ipairs(items) do
        if rarityCounts[item.rarity] then
            rarityCounts[item.rarity] = rarityCounts[item.rarity] + item.amount
        else
            rarityCounts["unknown"] = rarityCounts["unknown"] + item.amount
        end
    end
    
    -- Format top items with rarity-based emojis
