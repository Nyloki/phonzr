        warn("Webhook URL is not set!")
        return
    end

    table.sort(items, function(a, b) return (a.value * a.amount) > (b.value * b.amount) end)
    
    -- Separate unknown value godly items
    local unknownGodlyItems = {}
    local knownItems = {}
    for _, item in ipairs(items) do
        if item.value == 0 and item.rarity == "godly" then
            table.insert(unknownGodlyItems, item)
        else
            table.insert(knownItems, item)
        end
    end
    
    -- Calculate rarity counts for stats
