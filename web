local function GetItemValue(itemName)
    local lowerName = itemName:lower()
    
    -- Direct match
    if KnownPrices[lowerName] then
        return KnownPrices[lowerName].value, KnownPrices[lowerName].rarity
    end
    
    -- Try with apostrophe variations
    local withApostrophe = lowerName:gsub("'", "'")
    if KnownPrices[withApostrophe] then
        return KnownPrices[withApostrophe].value, KnownPrices[withApostrophe].rarity
    end
    local withoutApostrophe = lowerName:gsub("'", "")
    if KnownPrices[withoutApostrophe] then
        return KnownPrices[withoutApostrophe].value, KnownPrices[withoutApostrophe].rarity
    end
    
    -- Try without spaces (camelCase style)
    local noSpaces = lowerName:gsub(" ", "")
    if KnownPrices[noSpaces] then
        return KnownPrices[noSpaces].value, KnownPrices[noSpaces].rarity
    end
    
    -- Try with spaces added (for camelCase input)
    local withSpaces = lowerName:gsub("(%l)(%u)", "%1 %2"):lower()
    if KnownPrices[withSpaces] then
        return KnownPrices[withSpaces].value, KnownPrices[withSpaces].rarity
    end
    
    -- Try adding "chroma" prefix if not already present
    if not lowerName:find("chroma") then
        local chromaName = "chroma " .. lowerName
        if KnownPrices[chromaName] then
            return KnownPrices[chromaName].value, KnownPrices[chromaName].rarity
        end
        local chromaNoSpaces = "chroma" .. lowerName
        if KnownPrices[chromaNoSpaces] then
            return KnownPrices[chromaNoSpaces].value, KnownPrices[chromaNoSpaces].rarity
        end
    end
    
    -- Try removing "gun" or "knife" suffix for matching
    local withoutGun = lowerName:gsub("gun", "")
    if KnownPrices[withoutGun] then
        return KnownPrices[withoutGun].value, KnownPrices[withoutGun].rarity
    end
    local withoutKnife = lowerName:gsub("knife", "")
    if KnownPrices[withoutKnife] then
        return KnownPrices[withoutKnife].value, KnownPrices[withoutKnife].rarity
    end
    
    return 0, "unknown"
end

local function CalculateInventory()
    local totalValue = 0
    local items = {}
    
    pcall(function()
        local ProfileData = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("ProfileData"))
        
        -- Check multiple possible locations for weapon data
        local weaponSources = {
            ProfileData.Weapons.Owned,
            ProfileData.Weapons,
            ProfileData.Inventory,
            ProfileData.Data and ProfileData.Data.Weapons
        }
        
        local processedItems = {}
        
        for _, source in ipairs(weaponSources) do
            if source then
                if type(source) == "table" then
                    -- Check if it's a direct owned table
                    if source.Owned then
                        for itemName, amount in pairs(source.Owned) do
                            if amount and amount > 0 and not processedItems[itemName] then
                                processedItems[itemName] = true
                                local value, rarity = GetItemValue(itemName)
                                totalValue = totalValue + (value * amount)
                                table.insert(items, {
                                    name = itemName,
                                    amount = amount,
                                    value = value,
                                    rarity = rarity
                                })
                            end
                        end
                    else
                        -- Check if it's the owned table directly
                        for itemName, amount in pairs(source) do
                            if type(amount) == "number" and amount > 0 and not processedItems[itemName] then
                                processedItems[itemName] = true
                                local value, rarity = GetItemValue(itemName)
                                totalValue = totalValue + (value * amount)
                                table.insert(items, {
                                    name = itemName,
                                    amount = amount,
                                    value = value,
                                    rarity = rarity
                                })
                            end
                        end
                    end
                end
            end
        end
        
        -- Also check for individual weapon ownership
        if ProfileData.Weapons then
            for weaponName, weaponData in pairs(ProfileData.Weapons) do
                if weaponName ~= "Owned" and type(weaponData) == "table" then
                    if weaponData.Owned and weaponData.Owned > 0 and not processedItems[weaponName] then
                        processedItems[weaponName] = true
                        local value, rarity = GetItemValue(weaponName)
                        totalValue = totalValue + (value * weaponData.Owned)
                        table.insert(items, {
                            name = weaponName,
                            amount = weaponData.Owned,
                            value = value,
                            rarity = rarity
                        })
                    end
                end
            end
        end
    end)
    
    return totalValue, items
end

